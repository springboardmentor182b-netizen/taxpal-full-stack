{
  "name": "taxpal-server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "ts-node src/server.ts",
    "dev": "nodemon src/server.ts",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--max-old-space-size=4096 jest --forceExit --detectOpenHandles --runInBand",
    "test:watch": "cross-env NODE_ENV=test NODE_OPTIONS=--max-old-space-size=4096 jest --watch --runInBand",
    "test:coverage": "cross-env NODE_ENV=test NODE_OPTIONS=--max-old-space-size=4096 jest --coverage --forceExit --detectOpenHandles --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-validator": "^6.15.0",
    "googleapis": "^160.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.8.7",
    "nodemailer": "^7.0.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^7.0.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}