generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                   @id @default(uuid())
  name                 String
  email                String                   @unique
  password             String
  country              String?
  incomeBracket        String?
  createdAt            DateTime                 @default(now())
  username             String?                  @unique
  twoFactorEnabled     Boolean                  @default(false)
  budgets              Budget[]
  categories           Category[]
  refreshTokens        RefreshToken[]
  reports              Report[]
  taxEstimates         TaxEstimate[]
  transactions         Transaction[]
  notificationSettings UserNotificationSetting?
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Transaction {
  id          String   @id @default(uuid())
  type        String
  amount      Float
  category    String?
  date        DateTime
  createdAt   DateTime @default(now())
  userId      String
  description String
  notes       String?
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Budget {
  id          String   @id @default(uuid())
  category    String
  amount      Float
  month       DateTime
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  spent       Float    @default(0)
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Category {
  id        String   @id @default(uuid())
  name      String
  type      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  color     String?
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model UserNotificationSetting {
  id                 String   @id @default(uuid())
  userId             String   @unique
  emailNotifications Boolean  @default(true)
  transactionAlerts  Boolean  @default(true)
  budgetWarnings     Boolean  @default(true)
  taxReminders       Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id])
}

model TaxEstimate {
  id                   String   @id @default(uuid())
  userId               String
  country              String   @default("United States")
  state                String?
  status               String   @default("Single")
  quarter              String   @default("Q1")
  year                 Int
  income               Float
  businessExpenses     Float    @default(0)
  retirement           Float    @default(0)
  healthInsurance      Float    @default(0)
  homeOffice           Float    @default(0)
  additionalDeductions Float    @default(0)
  taxableIncome        Float
  estimatedTax         Float
  effectiveTaxRate     Float
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Report {
  id          String   @id @default(uuid())
  userId      String
  reportType  String
  period      String
  format      String
  filePath    String
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String?
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}
